[Unit]
Description=ProxyFleet Control Dashboard & Controller API
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/proxyfleet
Environment=NODE_ENV=production
Environment=PORT=1300
ExecStart=/usr/bin/node --import tsx src/server/server.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
