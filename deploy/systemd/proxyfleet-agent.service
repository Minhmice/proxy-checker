[Unit]
Description=ProxyFleet Node Worker Agent
After=network.target wg-quick@wg0.service
Wants=3proxy.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/proxyfleet-agent --server https://CONTROL_DOMAIN --config-dir /etc/proxyfleet --proxy-config /etc/3proxy/3proxy.cfg
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
