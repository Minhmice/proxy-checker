[Unit]
Description=3proxy Tiny Proxy Server
After=network-online.target wg-quick@proxyfleet.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/3proxy /etc/3proxy/3proxy.cfg
ExecReload=/bin/kill -SIGUSR1 $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
