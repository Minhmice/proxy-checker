{
  "name": "minhmiceproxy",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:restart": "node scripts/dev-stop.mjs && node --import tsx src/server/server.ts",
    "build": "next build",
    "start": "node --import tsx src/server/server.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src tests scripts",
    "format:check": "biome format src tests scripts",
    "format": "biome format --write",
    "db:preflight": "node --import tsx scripts/db-preflight.ts",
    "db:verify": "node --import tsx scripts/db-verify.ts",
    "test:msw-browser": "node --import tsx --test tests/msw/browser-contract.spec.ts",
    "test:a11y": "node --import tsx --test tests/a11y/dashboard.spec.ts",
    "healthcheck:9router": "node --import tsx scripts/9router-healthcheck.ts",
    "test:fleet": "node --import tsx --test tests/fleet-*.test.ts",
    "acceptance": "node --import tsx scripts/proxyfleet-acceptance.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@tanstack/react-table": "^9.2.4",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cobe": "^2.0.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.28.0",
    "motion": "^14.5.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ssh2": "^1.15.6",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "msw": "^3.0.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}