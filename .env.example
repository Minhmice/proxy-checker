# Bootstrap only — after first run, use Settings in the dashboard (data/settings.json)
# Loaded by src/server/load-env.ts; real process env (e.g. systemd EnvironmentFile) wins over this file.

# --- Server ---
PORT=1300
CONTROL_PASSWORD=replace-with-a-long-random-password
# Encrypts fleet secrets; falls back to CONTROL_PASSWORD when empty
FLEET_ENCRYPTION_KEY=

# --- Storage (set on Pi so data survives release updates; dev defaults to ./data and ./backups) ---
# APP_DATA_DIR=/var/lib/proxyfleet
# APP_BACKUP_DIR=/opt/proxyfleet/backups
# APP_CONFIG_PATH=/var/lib/proxyfleet/settings.json

# --- 9Router ---
NINEROUTER_URL=https://9router.minhmice.com
NINEROUTER_PASSWORD=your-9router-dashboard-password
NINEROUTER_API_KEY=
NINEROUTER_AUTO_SYNC=true
NINEROUTER_SYNC_MINUTES=60
ACTIVE_POOL_LIMIT=50
CHECK_CONCURRENCY=10
CHECK_TIMEOUT_MS=6000
PROXY_TTL_MINUTES=15

# --- Antigravity rotator ---
ANTIGRAVITY_ROTATOR_ENABLED=true
ANTIGRAVITY_ACTIVE_LIMIT=3
ANTIGRAVITY_ROTATE_MINUTES=10
ANTIGRAVITY_SESSION_THRESHOLD=20
ANTIGRAVITY_AUTHORITY_PRIVATE_KEY_PATH=

# --- Pi router SSH (interactive updater) ---
NINEROUTER_LAN_HOST=192.168.1.54
NINEROUTER_TAILSCALE_HOST=100.74.116.125
NINEROUTER_LAN_PORT=22
NINEROUTER_LAN_SSH_USER=minhmice
NINEROUTER_LAN_SSH_PASS=

# --- WireGuard enrollment ---
WIREGUARD_SERVER_PUBLIC_KEY=
WIREGUARD_SERVER_ENDPOINT=

# --- Optional standalone auditor intelligence providers ---
IPINFO_TOKEN=
IPQS_API_KEY=
ABUSEIPDB_API_KEY=
# Optional operator-controlled HTTPS integrity endpoint
CONTROL_ENDPOINT=
CONTROL_SPKI_SHA256=

# --- Pi deploy (dev machine -> Pi; read by deploy/pi/*.sh and your own ssh commands) ---
PI_SSH_HOST=192.168.1.54
PI_SSH_USER=minhmice
DEPLOY_BRANCH=main
DEPLOY_DIR=/opt/proxyfleet
DEPLOY_HEALTH_URL=http://127.0.0.1:1300/api/health
